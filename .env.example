# Copy to .env (gitignored). Every value here is a dummy.
# Proxy is optional. Leave all three blank to run without one.
QCOM_PROXY_SERVER=http://proxy.example.com:8000
QCOM_PROXY_USERNAME=dummy-user
QCOM_PROXY_PASSWORD=dummy-pass
# Optional: comma-separated extra servers to rotate to after PROXY_ERROR exhausts its attempts.
QCOM_PROXY_FALLBACK_SERVERS=
